[workspace]
channels = [
    "conda-forge",
]
description = "A basic single-user JupyterLab image"
name = "jupyter-pixi"
platforms = [
%{ if cpu_architecture == "arm64" ~}
    "linux-aarch64",
%{ else ~}
    "linux-64",
%{ endif ~}
]
version = "0.1.1"

[tasks]

[dependencies]
python = ">=3.12"

[pypi-dependencies]
jupyterlab = ">=4.6"
