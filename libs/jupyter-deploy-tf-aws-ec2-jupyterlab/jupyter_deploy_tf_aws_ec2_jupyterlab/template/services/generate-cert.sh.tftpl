#!/bin/bash
# Generate (once) a long-lived self-signed TLS cert + private key, persisted on the EBS
# data volume so a stop/start never rotates it, then publish ONLY the public PEM to the
# cert-pin SSM parameter that `jd proxy connect-info` reads. The private key never leaves
# the instance. The pin is on the cert, not the address (the client disables hostname
# verification), so the SAN is irrelevant.
set -e

mkdir -p /var/log/jupyter-deploy
exec > >(tee /var/log/jupyter-deploy/generate-cert.log) 2>&1

CERT_DIR="/mnt/jupyter-data/.jupyter-deploy-tls"
KEY_FILE="$${CERT_DIR}/key.pem"
CERT_FILE="$${CERT_DIR}/cert.pem"
DOCKER_CERT_DIR="/opt/docker/certs"
CERT_PIN_PARAM="${cert_pin_ssm_parameter_name}"
AWS_REGION="${aws_region}"

mkdir -p "$${CERT_DIR}"

if [ ! -f "$${KEY_FILE}" ] || [ ! -f "$${CERT_FILE}" ]; then
    echo "Generating self-signed certificate (10 year validity)..."
    openssl req -x509 -newkey rsa:2048 -nodes \
        -keyout "$${KEY_FILE}" \
        -out "$${CERT_FILE}" \
        -days 3650 \
        -subj "/CN=jupyter-deploy" \
        -addext "subjectAltName=DNS:jupyter-deploy,IP:127.0.0.1"
    chmod 600 "$${KEY_FILE}"
    chmod 644 "$${CERT_FILE}"
    echo "Certificate generated at $${CERT_FILE}"
else
    echo "Certificate already present at $${CERT_FILE}, reusing it"
fi

# Publish the public PEM to the cert-pin SSM parameter (idempotent — --overwrite).
echo "Publishing public certificate to SSM parameter $${CERT_PIN_PARAM}..."
aws ssm put-parameter \
    --name "$${CERT_PIN_PARAM}" \
    --type String \
    --tier Advanced \
    --overwrite \
    --value "$(cat "$${CERT_FILE}")" \
    --region "$${AWS_REGION}"
echo "Published cert pin"

# Make the cert/key available to the traefik container.
mkdir -p "$${DOCKER_CERT_DIR}"
cp "$${CERT_FILE}" "$${DOCKER_CERT_DIR}/cert.pem"
cp "$${KEY_FILE}" "$${DOCKER_CERT_DIR}/key.pem"
chmod 644 "$${DOCKER_CERT_DIR}/cert.pem"
chmod 600 "$${DOCKER_CERT_DIR}/key.pem"
echo "Copied cert/key to $${DOCKER_CERT_DIR}"
