#!/bin/bash
set -e

# Records logs
mkdir -p /var/log/jupyter-deploy
exec > >(tee /var/log/jupyter-deploy/cloudinit.log) 2>&1

# Detect OS
if [ -f /etc/os-release ]; then
    . /etc/os-release
    OS=$NAME
    VERSION=$VERSION_ID
else
    echo "Cannot detect OS version"
    exit 1
fi

if [[ "$OS" == "Amazon Linux" ]]; then
    yum update -y

    # docker
    if ! command -v docker &> /dev/null; then
        echo "Docker not found, installing..."
        yum install -y docker

        # Enable docker
        systemctl start docker
        systemctl enable docker
    else
        echo "Docker is already installed"
    fi

    # docker plugins
    ARCH=$(uname -m)
    BUILDX_ARCH=$(echo $${ARCH} | sed 's/x86_64/amd64/g' | sed 's/aarch64/arm64/g')
    mkdir -p /usr/local/lib/docker/cli-plugins

    # Resolve a repo's latest release tag, or fail. A GitHub 5xx or a rate-limit reply carries no
    # tag_name, and an empty version silently builds a `.../download//<asset>` URL.
    get_latest_release_tag() {
        local repo="$1" tag
        tag=$(curl -fsS --retry 3 --retry-delay 2 --retry-all-errors \
            "https://api.github.com/repos/$${repo}/releases/latest" \
            | grep '"tag_name"' | sed -E 's/.*"([^"]+)".*/\1/')
        if [ -z "$${tag}" ]; then
            echo "ERROR: could not resolve the latest release tag of $${repo} from the GitHub API" >&2
            return 1
        fi
        printf '%s\n' "$${tag}"
    }

    # Install a docker CLI plugin. Two failures this shape avoids, both seen live:
    # - without -f, curl writes the HTTP error body to its -o target, so a GitHub 5xx installs a
    #   157 KB "Server Error" HTML page as the plugin and chmod +x's it;
    # - writing straight over the destination fails with ETXTBSY on a re-run, because a running
    #   service holds the plugin open -- hence the temp path and the unlink before install(1).
    install_docker_plugin() {
        local url="$1" dest="$2" tmp
        tmp=$(mktemp)
        if ! curl -fsSL --retry 3 --retry-delay 2 --retry-all-errors "$${url}" -o "$${tmp}"; then
            echo "ERROR: could not download the docker plugin from $${url}" >&2
            rm -f "$${tmp}"
            return 1
        fi
        if [ ! -s "$${tmp}" ]; then
            echo "ERROR: the docker plugin downloaded from $${url} is empty" >&2
            rm -f "$${tmp}"
            return 1
        fi
        rm -f "$${dest}"
        install -m 755 "$${tmp}" "$${dest}"
        rm -f "$${tmp}"
    }

    # compose (uses x86_64, aarch64)
    COMPOSE_VERSION=$(get_latest_release_tag docker/compose)
    echo "Installing compose $${COMPOSE_VERSION}..."
    install_docker_plugin \
        "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-$${ARCH}" \
        /usr/local/lib/docker/cli-plugins/docker-compose
    docker compose version

    # buildx (uses amd64, arm64)
    BUILDX_VERSION=$(get_latest_release_tag docker/buildx)
    echo "Installing buildx $${BUILDX_VERSION}..."
    install_docker_plugin \
        "https://github.com/docker/buildx/releases/download/$${BUILDX_VERSION}/buildx-$${BUILDX_VERSION}.linux-$${BUILDX_ARCH}" \
        /usr/local/lib/docker/cli-plugins/docker-buildx
    docker buildx version

    echo "Docker plugins installation complete"

    # jq
    if ! command -v jq &> /dev/null; then
        echo "jq not found, installing..."
        yum install -y jq
    else
        echo "jq is already installed"
    fi

    # ensure SSM agent is active
    if ! systemctl is-active --quiet amazon-ssm-agent; then
        echo "SSM agent not running, checking if installed..."
        if ! rpm -q amazon-ssm-agent &> /dev/null; then
            echo "SSM agent not found, installing..."
            yum install -y amazon-ssm-agent
        fi
        echo "Starting SSM agent..."
        # Retry logic for systemd transaction conflicts during boot
        MAX_RETRIES=5
        RETRY_COUNT=0
        while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
            if systemctl start amazon-ssm-agent; then
                echo "SSM agent started successfully"
                systemctl enable amazon-ssm-agent
                break
            else
                RETRY_COUNT=$((RETRY_COUNT + 1))
                if [ $RETRY_COUNT -lt $MAX_RETRIES ]; then
                    echo "Failed to start SSM agent (attempt $RETRY_COUNT/$MAX_RETRIES), retrying in 5 seconds..."
                    sleep 5
                else
                    echo "Failed to start SSM agent after $MAX_RETRIES attempts"
                    exit 1
                fi
            fi
        done
    else
        echo "SSM agent is already running"
    fi
else
    echo "Unsupported OS version. This script only supports Amazon Linux."
    exit 1
fi

# service user (idempotent)
if ! id service-user >/dev/null 2>&1; then
    useradd -r -s /sbin/nologin -d /home/service-user -m service-user
fi
usermod -aG docker service-user

tee /etc/sudoers.d/service-user << EOF
service-user ALL=(ALL) NOPASSWD: /bin/systemctl start docker
service-user ALL=(ALL) NOPASSWD: /bin/systemctl stop docker
service-user ALL=(ALL) NOPASSWD: /bin/systemctl restart docker
service-user ALL=(ALL) NOPASSWD: /usr/local/bin/update-auth.sh
EOF
chmod 440 /etc/sudoers.d/service-user

tee /home/service-user/.bash_profile << EOF
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin
EOF

chown service-user:service-user /home/service-user/.bash_profile
chmod 644 /home/service-user/.bash_profile

mkdir -p /home/service-user/.aws
chown -R service-user:service-user /home/service-user

echo "Setting up resource limits..."
tee /etc/security/limits.d/service-user.conf << EOF
service-user soft nproc 1024
service-user hard nproc 2048
service-user soft nofile 4096
service-user hard nofile 8192
EOF
chmod 440 /etc/security/limits.d/service-user.conf

# Mount the jupyter-data drive and save config to persist on reboots
mkdir -p /mnt/jupyter-data
if ! blkid /dev/sdf | grep -q 'TYPE="ext4"'; then
    echo "Formatting /dev/sdf as ext4..."
    mkfs -t ext4 /dev/sdf
else
    echo "/dev/sdf is already formatted"
fi
if ! mountpoint -q /mnt/jupyter-data; then
    mount /dev/sdf /mnt/jupyter-data
fi

chown -R service-user:service-user /mnt/jupyter-data
chmod 750 /mnt/jupyter-data
if ! grep -q '/mnt/jupyter-data' /etc/fstab; then
    echo "/dev/sdf /mnt/jupyter-data ext4 defaults,nofail 0 2" | tee -a /etc/fstab
fi

# Create dirs
mkdir -p /opt/docker
touch /opt/docker/acme.json
chown service-user:service-user /opt/docker/acme.json
chmod 600 /opt/docker/acme.json

mkdir -p /var/log/services

# Create the AUTHED_ENTITIES file only on first boot.
# Runtime changes (jd users/organization/teams commands) modify this file
# directly via update-auth.sh and must survive host restarts.
#
# The allowlist is FETCHED from SSM Parameter Store rather than interpolated into this script, even
# though terraform knows the values here. Interpolating them makes them part of this script's text,
# which is part of the startup document, which is hashed into the association's replace trigger --
# so editing an allowlist variable and running `jd up` would replace the association and re-run the
# whole boot path, including `docker compose up --force-recreate`. That kills every kernel and drops
# every session to change a list of names. Reading the value out of band keeps this script byte-identical
# across allowlist edits, so `jd up` reconciles the running allowlist through the auth container alone
# (see null_resource.reconcile_auth_allowlist in engine/services.tf).
#
# Still first-boot-guarded: on a restart the on-instance file is authoritative, because a
# `jd users add` between two applies has updated the file and the terraform variable but not yet this
# parameter. Seeding from the parameter on every boot would silently revert that change.
if [ ! -f /etc/AUTHED_ENTITIES ]; then
    # Fail the boot rather than come up with an empty allowlist: docker-startup.sh refuses to start the
    # stack without at least one allowlisted entity, so an unreadable parameter must surface as itself
    # rather than as a confusing downstream "No authentication restrictions found".
    if ! ALLOWLIST=$(aws ssm get-parameter \
        --region ${aws_region} \
        --name ${auth_allowlist_parameter_name} \
        --query Parameter.Value \
        --output text); then
        echo "ERROR: could not read the access allowlist from SSM parameter ${auth_allowlist_parameter_name}"
        exit 1
    fi
    printf '%s\n' "$ALLOWLIST" > /etc/AUTHED_ENTITIES
    chmod 600 /etc/AUTHED_ENTITIES
    chown service-user:service-user /etc/AUTHED_ENTITIES
fi
