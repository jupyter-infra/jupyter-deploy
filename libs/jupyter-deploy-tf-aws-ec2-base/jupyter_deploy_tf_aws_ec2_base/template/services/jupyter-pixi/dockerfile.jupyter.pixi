ARG CLAUDE_CODE_VERSION
ARG CODEX_VERSION

# Coding agent CLIs. The npm packages wrap native binaries but need a newer node
# than trixie ships, so install them here and copy the prefix (plus node, for the
# codex launcher) into the final image.
FROM node:22-trixie-slim AS ai-clis
ARG CLAUDE_CODE_VERSION
ARG CODEX_VERSION
RUN test -n "$CLAUDE_CODE_VERSION" && test -n "$CODEX_VERSION" && \
    npm install -g --prefix /opt/ai-clis \
      "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
      "@openai/codex@${CODEX_VERSION}" && \
    npm cache clean --force

FROM ghcr.io/astral-sh/uv:python3.13-trixie-slim

ARG SERVICE_GID
ARG DOCKER_GID
ARG SERVICE_UID
ARG CODEX_PROFILE_PREFIX
ARG CODEX_MODEL_PATTERNS

USER root

# map docker group with specific GIDs
RUN groupadd -g ${DOCKER_GID} docker && \
    groupadd -g ${SERVICE_GID} jovyan

# non-root user
RUN useradd -m -s /bin/bash -u ${SERVICE_UID} -g ${SERVICE_GID} -G docker jovyan

# system dependencies
# git for the coding agents' repo awareness; procps (ps) for the Codex TUI,
# which tracks its background app-server by pid.
RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    ca-certificates \
    curl \
    git \
    gnupg \
    procps

# docker
RUN install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | \
    gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch="$(dpkg --print-architecture)" signed-by=/etc/apt/keyrings/docker.gpg] \
    https://download.docker.com/linux/debian $(. /etc/os-release && echo $VERSION_CODENAME) stable" | \
    tee /etc/apt/sources.list.d/docker.list > /dev/null

RUN apt-get update && \
    apt-get install -y docker-ce-cli && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# uv kernel env
RUN mkdir -p /opt/uv/kernel
COPY pyproject.kernel.toml /opt/uv/kernel/pyproject.toml
RUN uv sync --directory /opt/uv/kernel

# pixi
ENV PIXI_HOME="/opt/pixi/.pixi"
RUN mkdir -p /opt/pixi/jupyter
RUN curl -fsSL https://pixi.sh/install.sh | sh
ENV PATH="/opt/pixi/.pixi/bin:${PATH}"
RUN echo "Pixi installation complete, checking version" && pixi --version

# jupyter dirs
RUN mkdir -p /etc/jupyter
COPY jupyter_server_config.py /etc/jupyter/

# pixi env
COPY pixi.jupyter.toml /opt/pixi/jupyter/pixi.toml
WORKDIR /opt/pixi/jupyter
RUN pixi install

# coding agents, installed outside /home/jovyan, which the data volume mounts over.
# Both CLIs reach Bedrock with a Bedrock-only role's credentials, handed to the container read-only;
# the region and inference profile prefix come from the docker-compose environment.
COPY --from=ai-clis /usr/local/bin/node /usr/local/bin/node
COPY --from=ai-clis /opt/ai-clis /opt/ai-clis
RUN ln -s /opt/ai-clis/bin/claude /usr/local/bin/claude && \
    ln -s /opt/ai-clis/bin/codex /usr/local/bin/codex
COPY claude-managed-settings.json /etc/claude-code/managed-settings.json
COPY codex-config.toml /etc/codex/config.toml
# Codex's model is pinned at build from the installed release's catalog so it follows the pinned
# version and the models IAM allows; the script documents the placeholder and failure cases.
COPY pick-codex-model.py /tmp/pick-codex-model.py
RUN python3 /tmp/pick-codex-model.py "$CODEX_PROFILE_PREFIX" "$CODEX_MODEL_PATTERNS" /etc/codex/config.toml && \
    rm /tmp/pick-codex-model.py

# start-up scripts
COPY jupyter-start.sh /usr/local/bin/
COPY jupyter-reset.sh /usr/local/bin/

# dirs ownership
RUN chmod -R a+r /opt/pixi
RUN chmod -R a+r /opt/uv
RUN chmod -R a+r /etc/jupyter /etc/claude-code /etc/codex
RUN chmod +x /usr/local/bin/jupyter-start.sh
RUN chmod +x /usr/local/bin/jupyter-reset.sh
RUN chown -R jovyan:jovyan /home/jovyan

# switch user
WORKDIR /home/jovyan
USER jovyan

ENTRYPOINT ["/usr/local/bin/jupyter-start.sh"]