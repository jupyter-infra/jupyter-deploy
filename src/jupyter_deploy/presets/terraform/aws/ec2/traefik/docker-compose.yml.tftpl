services:
  jupyter:
    user: "$${SERVICE_UID}:$${SERVICE_GID}"
    group_add:
      - "$${DOCKER_GID}"
    build:
      context: .
      dockerfile: dockerfile.jupyter
      args:
        - SERVICE_UID=$${SERVICE_UID}
        - SERVICE_GID=$${SERVICE_GID}
        - DOCKER_GID=$${DOCKER_GID}
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    networks:
      - web
    environment:
      - JUPYTER_TOKEN=""
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.jupyter.rule=Host(`jupyter.${full_domain}`)"
      - "traefik.http.routers.jupyter.entrypoints=websecure"
      - "traefik.http.routers.jupyter.tls.certresolver=letsencrypt"
      - "traefik.http.routers.jupyter.middlewares=oauth@docker"
      - "traefik.http.services.jupyter.loadbalancer.server.port=8888"
    volumes:
      - /mnt/jupyter-data:/home/jovyan
      - /var/run/docker.sock:/var/run/docker.sock
  oauth:
    image: thomseddon/traefik-forward-auth:2.2
    user: "$${SERVICE_UID}:$${SERVICE_GID}"
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.oauth.rule=Host(`auth.${full_domain}`)"
      - "traefik.http.routers.oauth.entrypoints=websecure"
      - "traefik.http.routers.oauth.tls.certresolver=letsencrypt"
    networks:
      - web
    environment:
      - CLIENT_ID=${github_client_id}
      - CLIENT_SECRET=$${GITHUB_CLIENT_SECRET}
      - SECRET=$${OAUTH_SECRET}
      - PROVIDERS_GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
      - PROVIDERS_GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
      - PROVIDERS_GITHUB_OAUTH_USER_INFO_URL=https://api.github.com/user
      - AUTH_HOST=auth.${full_domain}
      - COOKIE_DOMAIN=${full_domain}
      - INSECURE_COOKIE=false
      - WHITELIST=${allowed_github_usernames}
  traefik:
    image: traefik:v2.10
    user: "$${SERVICE_UID}:$${SERVICE_GID}"
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    ports:
      - "443:8443"
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik.yml:/traefik.yml:ro
      - /root/.aws:/root/.aws:ro
      - ./acme.json:/acme.json
    networks:
      - web
networks:
  web:
    driver: bridge